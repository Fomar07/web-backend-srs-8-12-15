{
  "info": {
    "name": "Практика 11 / Фитнес",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3211"
    },
    {
      "key": "newEmail",
      "value": "client-{{$timestamp}}@example.test"
    }
  ],
  "item": [
    {
      "name": "01 Список",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Создать: Бег",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"Бег\", \"duration\": 30, \"calories\": 300, \"date\": \"2027-01-02T08:00:00.000Z\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id2',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Создать: Плавание",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"Плавание\", \"duration\": 45, \"calories\": 300, \"date\": \"2027-01-03T08:00:00.000Z\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id3',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Создать: Силовая",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"Силовая\", \"duration\": 60, \"calories\": 300, \"date\": \"2027-01-04T08:00:00.000Z\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id4',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Список после создания",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Минимальная длительность",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?minDuration=40"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.test('duration >= 40',()=>pm.expect((d.items||d).every(x=>x.duration>=40)).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Тип тренировки",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?type=%D0%9F%D0%BB%D0%B0%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Поиск без регистра",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?search=%D0%B1%D0%B5%D0%B3"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Сортировка",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?sort=duration_desc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Статистика",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Изменить",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items/{{id2}}",
        "body": {
          "mode": "raw",
          "raw": "{\"duration\": 35}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Удалить",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/items/{{id3}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Короткое название",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"X\", \"duration\": 20}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Отрицательная длительность",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"Тест\", \"duration\": -5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Прочитать одну запись",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/{{id2}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Отсутствующая запись",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/000000000000000000000000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Неверный ObjectId",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/not-an-id"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Отрицательные калории при PUT",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items/{{id2}}",
        "body": {
          "mode": "raw",
          "raw": "{\"calories\": -1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if(pm.info.requestName==='Регистрация клиента')pm.collectionVariables.set('newEmail','lab-'+Date.now()+'@example.test');"
        ]
      }
    }
  ]
}