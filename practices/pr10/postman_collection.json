{
  "info": {
    "name": "Практика 10 / Фитнес",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3210"
    },
    {
      "key": "newEmail",
      "value": "client-{{$timestamp}}@example.test"
    }
  ],
  "item": [
    {
      "name": "Данные из MongoDB",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Создание документа",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"Тест API\", \"duration\": 25, \"calories\": 120}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Длительность",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?minDuration=40"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Тип",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?type=%D0%91%D0%B5%D0%B3"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Поиск",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?search=%D0%BF%D0%BB%D0%B0%D0%B2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Массив упражнений",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?exercise=%D0%9F%D0%BB%D0%B0%D0%BD%D0%BA%D0%B0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Агрегация",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Lookup: данные тренера",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('trainerData',()=>pm.expect(pm.response.json().some(x=>x.trainerData?.name)).to.be.true);"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if(pm.info.requestName==='Регистрация клиента')pm.collectionVariables.set('newEmail','lab-'+Date.now()+'@example.test');"
        ]
      }
    }
  ]
}