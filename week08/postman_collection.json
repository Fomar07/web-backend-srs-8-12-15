{
  "info": {
    "name": "Фитнес-трекер СРС 8",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3108"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create workout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/workouts",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"Плавание\", \"duration\": 40, \"date\": \"2026-10-24\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const item=pm.response.json();pm.collectionVariables.set('id',item._id||item.id);pm.test('Duration 40',()=>pm.expect(item.duration).to.eql(40));"
            ]
          }
        }
      ]
    },
    {
      "name": "List workouts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workouts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read workout",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workouts/{{id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update workout",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/workouts/{{id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"duration\": 50}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Duration 50',()=>pm.expect(pm.response.json().duration).to.eql(50));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid duration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/workouts",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"Бег\", \"duration\": 0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete workout",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/workouts/{{id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted workout",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workouts/{{id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
